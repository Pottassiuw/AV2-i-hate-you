{
  "name": "greencode-av2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API monolítica de logística reversa — AV2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "test": "node --env-file=.env --import tsx --test test/http.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/jwt": "10.2.5",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "5.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sinclair/typebox": "0.34.41",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "dotenv": "18.0.8",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
