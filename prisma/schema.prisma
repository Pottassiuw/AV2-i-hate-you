generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  OPERADOR_ALMOXARIFADO
  AUDITOR
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

model Usuario {
  id            String              @id @default(uuid()) @db.Uuid
  email         String              @unique @db.VarChar(254)
  hashSenha     String
  papel         PapelUsuario
  ativo         Boolean             @default(true)
  dataCadastro  DateTime            @default(now()) @db.Timestamptz(3)
  versao        Int                 @default(0)
  movimentacoes Movimentacao[]
  tokenVersao   Int                 @default(0)
  auditoria     RegistroAuditoria[]
}

model Organizacao {
  id                String    @id @default(uuid()) @db.Uuid
  razaoSocial       String    @db.VarChar(200)
  cnpj              String    @unique @db.VarChar(14)
  inscricaoEstadual String?   @db.VarChar(30)
  enderecoCompleto  String    @db.VarChar(500)
  telefone          String    @db.VarChar(30)
  email             String    @db.VarChar(254)
  dataCadastro      DateTime  @default(now()) @db.Timestamptz(3)
  ativo             Boolean   @default(true)
  versao            Int       @default(0)
  contrato          Contrato?
  lotes             Lote[]
}

model Contrato {
  id                  String      @id @default(uuid()) @db.Uuid
  organizacaoId       String      @unique @db.Uuid
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  dataAssinatura      DateTime    @db.Date
  dataVencimento      DateTime    @db.Date
  clausulas           Json        @default("[]")
  valorMensal         Decimal     @db.Decimal(12, 2)
  renovacaoAutomatica Boolean     @default(false)
  versao              Int         @default(0)
}

model Lote {
  id                  String        @id @default(uuid()) @db.Uuid
  dataEntrada         DateTime      @db.Date
  organizacaoId       String        @db.Uuid
  organizacao         Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  notaFiscal          String        @db.VarChar(60)
  transportadora      String        @db.VarChar(200)
  statusProcessamento StatusLote    @default(RECEBIDO)
  observacoes         String?       @db.VarChar(2000)
  versao              Int           @default(0)
  equipamentos        Equipamento[]

  @@index([organizacaoId, dataEntrada])
}

model Equipamento {
  id                  String             @id @default(uuid()) @db.Uuid
  codigoBarrasInterno String             @unique @db.VarChar(80)
  tipo                TipoEquipamento
  marca               String             @db.VarChar(100)
  modelo              String             @db.VarChar(100)
  anoFabricacao       Int
  estadoFisico        EstadoFisico
  pesoQuilogramas     Decimal            @db.Decimal(10, 3)
  loteId              String             @db.Uuid
  lote                Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  posicaoNoLote       Int
  statusRastreamento  StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  triagemConcluidaEm  DateTime?          @db.Timestamptz(3)
  versao              Int                @default(0)
  movimentacoes       Movimentacao[]

  @@unique([loteId, posicaoNoLote])
}

model Movimentacao {
  id                   String              @id @default(uuid()) @db.Uuid
  equipamentoId        String              @db.Uuid
  equipamento          Equipamento         @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  dataHora             DateTime            @default(now()) @db.Timestamptz(3)
  origem               String              @db.VarChar(200)
  destino              String              @db.VarChar(200)
  responsavelId        String              @db.Uuid
  responsavel          Usuario             @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  observacao           String?             @db.VarChar(2000)
  justificativa        String?             @db.VarChar(2000)
  statusAnterior       StatusRastreamento?
  statusNovo           StatusRastreamento
  estadoFisicoAnterior EstadoFisico?
  estadoFisicoNovo     EstadoFisico
  versaoEquipamento    Int
  versao               Int                 @default(0)

  @@unique([equipamentoId, versaoEquipamento])
}

model ParametrosSistema {
  id                  Int      @id @default(1)
  aliquotaImposto     Decimal  @default(0) @db.Decimal(5, 4)
  depreciacaoAnual    Decimal  @default(0.10) @db.Decimal(5, 4)
  valorBaseQuilograma Decimal  @default(10) @db.Decimal(12, 2)
  atualizadoEm        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  versao              Int      @default(0)
}

model RegistroAuditoria {
  id            String   @id @default(uuid()) @db.Uuid
  dataHora      DateTime @default(now()) @db.Timestamptz(3)
  responsavelId String   @db.Uuid
  responsavel   Usuario  @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  entidade      String   @db.VarChar(40)
  entidadeId    String   @db.VarChar(100)
  acao          String   @db.VarChar(40)
  antes         Json?
  depois        Json?

  @@index([entidade, entidadeId, dataHora])
}
